<UserControl x:Class="AlertBarWpf.AlertBarWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:AlertBarWpf"
             xmlns:conv="clr-namespace:AlertBarWpf.Converters"
             d:DesignHeight="40" d:DesignWidth="300">

    <UserControl.Resources>
        <conv:AlertTypeToIconGeometryConverter x:Key="AlertTypeToIconGeometryConverter" />
        <conv:AlertTypeToBrushConverter x:Key="AlertTypeToBrushConverter" />
        <conv:IconColumnWidthConverter x:Key="IconColumnWidthConverter" />
        <conv:DensityToCloseColumnWidthConverter x:Key="DensityToCloseColumnWidthConverter" />
        <conv:CloseGlyphStrokeConverter x:Key="CloseGlyphStrokeConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="local:AlertBarWpf.Show">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Name="AnimationObject" Storyboard.TargetName="grdWrapper" Completed="AnimationObject_Completed">
                        <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                        <EasingDoubleKeyFrame x:Name="key1" KeyTime="0:0:5" Value="1"/>
                        <EasingDoubleKeyFrame x:Name="key2" KeyTime="0:0:6" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <!--
        A single visual tree shared by both themes. Theme-specific appearance (background vs. outline,
        text color, close-icon color) is switched with DataTriggers bound back to this control's own
        Theme/IconVisibility/CurrentAlertType properties via RelativeSource, instead of maintaining two
        parallel StackPanels and walking the visual tree in code-behind.
    -->
    <Grid Name="grdWrapper" Visibility="Collapsed">
        <Border x:Name="bdr">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                    <!-- Pins the bar's height so hiding the icon (IconVisibility=False) doesn't shrink the row -
                         a Collapsed icon no longer contributes to the Grid's auto-height otherwise. -->
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Background" Value="{Binding CurrentAlertType, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource AlertTypeToBrushConverter}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Theme, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Outline">
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="CornerRadius" Value="5" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{Binding CurrentAlertType, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource AlertTypeToBrushConverter}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Density, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Compact">
                            <Setter Property="MinHeight" Value="24" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Data binding on ColumnDefinition.Width has only been supported since WPF on .NET Core 3.0+. -->
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource IconColumnWidthConverter}">
                                <Binding Path="IconVisibility" RelativeSource="{RelativeSource AncestorType=local:AlertBarWpf}" />
                                <Binding Path="Density" RelativeSource="{RelativeSource AncestorType=local:AlertBarWpf}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding Density, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource DensityToCloseColumnWidthConverter}}" />
                </Grid.ColumnDefinitions>

                <!-- Stroke-only vector glyph (see AlertTypeToIconGeometryConverter) instead of a raster PNG per type. -->
                <Path Grid.Column="0" VerticalAlignment="Center" Stretch="Uniform"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource BoolToVisibilityConverter}}"
                      Data="{Binding CurrentAlertType, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource AlertTypeToIconGeometryConverter}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Stroke" Value="White" />
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Margin" Value="10,6,0,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Theme, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Outline">
                                    <Setter Property="Stroke" Value="{Binding CurrentAlertType, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource AlertTypeToBrushConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Density, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Compact">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="Height" Value="16" />
                                    <Setter Property="Margin" Value="10,4,0,4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <TextBlock FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"
                           Text="{Binding Message, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Margin" Value="8,0,8,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Theme, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Outline">
                                    <Setter Property="Foreground" Value="{Binding CurrentAlertType, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}, Converter={StaticResource AlertTypeToBrushConverter}}" />
                                </DataTrigger>
                                <!-- Wins over the Outline trigger above (declared later) since Neutral's pale accent can't carry white or accent-colored text. -->
                                <DataTrigger Binding="{Binding CurrentAlertType, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Neutral">
                                    <Setter Property="Foreground" Value="#333333" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Density, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Compact">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Margin" Value="5,0,5,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--
                    Vector close glyph. The Grid (not the Path) owns hit-testing/hover, since the Path
                    itself is just two open line strokes and wouldn't register the mouse in the gaps
                    between them. The Path's Stroke comes from a MultiBinding of [this Grid's IsMouseOver,
                    the control's Theme] so no close.png / close-hover.png / closeBL.png assets are needed.
                    Both the Grid's size and the Path's Data scale down together under Density=Compact.
                -->
                <Grid x:Name="closeHost" Background="Transparent" Cursor="Hand"
                      MouseUp="CloseButton_MouseUp" Grid.Column="2" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="12" />
                            <Setter Property="Height" Value="12" />
                            <Setter Property="Margin" Value="0,6,10,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Density, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Compact">
                                    <Setter Property="Width" Value="10" />
                                    <Setter Property="Height" Value="10" />
                                    <Setter Property="Margin" Value="0,4,10,4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Path StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M1,1 L11,11 M11,1 L1,11" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Density, RelativeSource={RelativeSource AncestorType=local:AlertBarWpf}}" Value="Compact">
                                        <Setter Property="Data" Value="M1,1 L9,9 M9,1 L1,9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                        <Path.Stroke>
                            <MultiBinding Converter="{StaticResource CloseGlyphStrokeConverter}">
                                <Binding ElementName="closeHost" Path="IsMouseOver" />
                                <Binding Path="Theme" RelativeSource="{RelativeSource AncestorType=local:AlertBarWpf}" />
                                <Binding Path="CurrentAlertType" RelativeSource="{RelativeSource AncestorType=local:AlertBarWpf}" />
                            </MultiBinding>
                        </Path.Stroke>
                    </Path>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
