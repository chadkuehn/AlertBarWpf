<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netcoreapp3.1-windows;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>AlertBarWpf</RootNamespace>
    <AssemblyName>AlertBarWpf</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AlertBarWpf</PackageId>
    <Authors>Chad Kuehn</Authors>
    <Description>A WPF UserControl for displaying user updates through a themeable alert bar.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/chadkuehn/AlertBarWpf</RepositoryUrl>
    <PackageProjectUrl>https://github.com/chadkuehn/AlertBarWpf</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
